        "criteria": null
      },
      "supersede": {
        "type": "choice",
        "instructions": "新出现的信息与已有旧记忆卡片属于哪种关系？",
        "criteria": {
          "unrelated": "主题不同，互不影响",
          "coexist": "补充或新增，两者可同时成立（含：主题相邻但属性不同、意向或计划尚未落实、同一对象的新事件）",
          "supersede": "新信息改写了旧卡片的同一属性，使旧内容过期失效"
        }
      },
      "backfill": {
        "type": "noul",
        "instructions": "事件 A 与事件 B 之间是否存在明确、可定向的因果关系（能具体写成一句『因为……所以……』）？只有时间相邻、主题相似但无法给出明确因果解释，或因果方向无法确定的 → 不存在因果关系（低概率）。",
        "criteria": null
      },
      "shortlist": {
        "type": "score",
        "instructions": "候选记忆卡片与用户当前问题的相关程度属于哪一档？",
        "criteria": [
          "不相关：对回答无帮助，甚至存在误导（如已被取代的旧状态、主题相邻但意图无关）",
          "部分相关：有助于裁剪或补充回答（背景、偏好倾向），但不是回答所必需",
          "高度相关：直接决定或直接构成回答的关键内容（关键事实、直接素材、关键约束）"
        ]
      }
    }
