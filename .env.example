# ===== 大模型（生成用；实验期冻结：换模型 = 换实验条件）=====
# DeepSeek 开放平台（platform.deepseek.com）申请 API Key；模型名以官方文档为准
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== 数据库（开发/评测用 SQLite：零安装，自动建库文件；启动目录须为 AI-Customer-Service）=====
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 演示期切 MySQL 时改用下一行（先在 MySQL 建好空库；URL 格式：mysql+aiomysql://用户名:密码@主机:端口/库名）
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/AI_Agent_DB

# ===== Redis（热层滑动窗口）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== 消融开关矩阵（E3；权威说明：docs/配置与埋点文档.md）=====
# 预设一键切档：B1 全历史 / B2 滑动窗口 / B3 存而不用 / B4P 朴素RAG / B4 扁平向量 / B5 完整系统（默认）
# PRESET=B5
# 单开关可单独覆盖（不设则按预设展开；供 H2/H3 单因子实验）：
# CONTEXT_MODE=window+memory    # full_history / window / window+memory
# WRITE_MODE=cards              # off / raw_chunks / cards
# RETRIEVAL_MODE=full           # off / flat_raw / flat / full
# SUPERSEDE_ENABLED=True
# EVICT_ENABLED=True
# GATE_ENABLED=True
# 策略参数（占位初始值；由对应阶段用 dev 集校准。改默认值须三处同步：代码 / .env.example / .env）：
# WINDOW_SIZE=10
# FULL_HISTORY_MAX_MESSAGES=200
# GATE_THRESHOLD=0.35
# EXTRACT_WATERMARK_ROUNDS=4
# EXTRACT_IDLE_TIMEOUT_MINUTES=30
# EXTRACT_MODEL=deepseek-flash     # 抽取模型（不设=跟随 LLM_MODEL；实验期冻结：换模型 = 换实验条件）
# RAW_CHUNK_SIZE=200               # B4′ 原文切块粒度（字符）
# LINE_PREFETCH_LIMIT=3
# INJECT_MAX_CARDS=3
# SOURCE_SCAN_LIMIT=200

# ===== 淘汰与编辑层（E11；确定性规则参数，零 LLM）=====
# EVICT_GOAL_GRACE_DAYS=30         # 目标卡过期宽限：event_time + 本值 < now → 下架
# EVICT_PREF_HALFLIFE_DAYS=90      # 偏好卡半衰期（天）：score = 0.5^(age/HL)；explicit ×2
# EVICT_MIN_SCORE=0.25             # 衰减下架阈值：score < 本值 → evicted
# 淘汰日志 / 编辑审计日志（相对路径基于 AI-Customer-Service；运行状态载体，不进实验快照）：
# EVICT_LOG_PATH=data/evict_log.jsonl
# EDIT_LOG_PATH=data/edit_log.jsonl

# ===== 判定器（E7；gate.py 消费。实验期冻结：换判定模型 = 换实验条件）=====
# GATE_MODEL=deepseek-flash      # 判定模型（不设=跟随 LLM_MODEL）
# GATE_UPGRADE_MODEL=            # 更强模型升级档（不设=不启用）
# GATE_TIMEOUT_SECONDS=6.0
# GATE_CONFIDENCE_MIN=0.5
# GATE_PREFILTER_ENABLED=True

# ===== 埋点（E3；JSONL 按天落盘，P1 回放与指标的唯一输入）=====
# TELEMETRY_ENABLED=True
# TELEMETRY_DIR=data/telemetry

# ===== Qdrant 向量库（E5 已接入；唯一封装在 store.py）=====
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=memory_cards
# QDRANT_TIMEOUT=3.0
# QDRANT_ENABLED=True

# ===== Embedding（E5 定稿：D17；正式实验冻结此选型）=====
# provider=api（默认，质量优先）：OpenAI 兼容接口（硅基流动），拿到 key 后填入并取消注释
# EMBEDDING_PROVIDER=api
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_DIM=1024
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# provider=local（离线兜底；需按需安装 torch / sentence-transformers 并预下载模型）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 调试模式：开启日志 DEBUG 级别
# DEBUG_MODE=True
