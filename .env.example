# ===== 大模型（生成用）=====
# DeepSeek 开放平台（platform.deepseek.com）申请 API Key；模型名以官方文档为准
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== 数据库（开发/演示用 SQLite：零安装，自动建库文件；启动目录须为 AI-Customer-Service）=====
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 演示期切 MySQL 时改用下一行（先在 MySQL 建好空库；URL 格式：mysql+aiomysql://用户名:密码@主机:端口/库名）
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/AI_Agent_DB

# ===== Redis（热层滑动窗口）=====
# 本机直跑用 localhost；docker compose 会覆盖为 redis
REDIS_HOST=localhost
# 故障快速降级：连接/读写超时（秒），Redis 不可达时 1s 内失败
# REDIS_CONNECT_TIMEOUT=1.0
# REDIS_SOCKET_TIMEOUT=1.0
REDIS_PORT=6379
REDIS_DB=0

# ===== 策略参数（不设即用代码默认值；改默认值须三处同步：代码 / .env.example / .env）=====
# WINDOW_SIZE=20                   # 短期窗口保留的消息条数（10 轮）
# GATE_THRESHOLD=0.35              # 精筛硬阈值：档位折算分低于此值不注入
# INJECT_MAX_CARDS=6               # 单轮注入上限（精筛后截断）
# RETRIEVAL_COARSE_TOPK=20         # 粗排候选预算：候选超过该数时按语义分截断后再精筛
# SOURCE_SCAN_LIMIT=200            # 回源翻查条数上限
# RERANK_ENABLED=True              # 精排总开关（每查询 60+ 次逐卡判定，占九成 token）
                                  # 对话页的开关会逐轮覆盖这里的值
# EXTRACT_WATERMARK_ROUNDS=4       # 攒批轮数：待抽消息 ≥ N×2 条即触发
# EXTRACT_IDLE_TIMEOUT_MINUTES=30  # 空闲收口：全局静默超时后补抽
# EXTRACT_MODEL=deepseek-flash     # 抽取模型（不设=跟随 LLM_MODEL）

# ===== 淘汰与编辑层（确定性规则参数，零 LLM）=====
# EVICT_GOAL_GRACE_DAYS=30         # 目标卡过期宽限：event_time + 本值 < now → 下架
# EVICT_PREF_HALFLIFE_DAYS=90      # 偏好卡半衰期（天）：score = 0.5^(age/HL)；explicit ×2
# EVICT_MIN_SCORE=0.25             # 衰减下架阈值：score < 本值 → evicted
# 淘汰日志 / 编辑审计日志（相对路径基于 AI-Customer-Service）：
# EVICT_LOG_PATH=data/evict_log.jsonl
# EDIT_LOG_PATH=data/edit_log.jsonl

# ===== 判定器（gate.py 消费）=====
# GATE_MODEL=deepseek-flash        # 判定模型（不设=跟随 LLM_MODEL）
# GATE_UPGRADE_MODEL=              # 更强模型升级档（不设=不启用）
# GATE_TIMEOUT_SECONDS=6.0
# GATE_CONFIDENCE_MIN=0.5

# ===== 运行指标（JSONL 按天落盘）=====
# TELEMETRY_ENABLED=True
# TELEMETRY_DIR=data/telemetry

# ===== Qdrant 向量库（唯一封装在 store.py）=====
# 本机直跑用 localhost；docker compose 会覆盖为 http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memory_cards
QDRANT_TIMEOUT=3.0
QDRANT_ENABLED=True

# ===== Embedding =====
# provider=api（默认）：OpenAI 兼容接口（硅基流动）
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx

# provider=local（离线兜底；主镜像不含 torch，需另装并预下载模型）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 调试模式：开启日志 DEBUG 级别
# DEBUG_MODE=True
