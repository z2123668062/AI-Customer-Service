# 忽略虚拟环境
.venv/
venv/
env/

# 忽略 Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 忽略本地配置
.env
.idea/

#忽略个人测试文件
garbage/
exercises/

#忽略日志文件
logs/

#忽略数据库文件
*.db
*.sqlite
*.mysql
data/
# 例外：评测数据集要随仓库走（否则 clone 下来跑不了 bench）
!bench/data/
!bench/data/**

#忽略 QA 运行产物（跑一次生成一次，正式结论以 qa_v1/ANALYSIS.md 为准）
qa_v1/records/

# 只忽略仓库根目录的旧 compose；deploy/ 下的部署编排要入库
/docker-compose.yml

# 私人文档与工具产物（不入库）
design/
bench/docs/PAPER_DRAFT.md
.mimosa/
web/.mimosa/
deploy/.env.docker.local
deploy/Dockerfile.web.local
# 鉴权密码文件（含哈希），不入库；CVM 上用命令现生成
deploy/.htpasswd

# 前端依赖与构建产物（web/ 是 Vue 前端）
web/node_modules/
web/dist/
web/.vite/
web/dev.log
web/dev.err
